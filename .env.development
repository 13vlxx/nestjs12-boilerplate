# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Base URL of the front-end, used to build links in emails
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL from docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nestjs12_boilerplate?schema=public

# JWT
JWT_ACCESS_TOKEN_SECRET=dev-only-access-secret-change-me-in-production
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_SECRET=dev-only-refresh-secret-change-me-in-production
JWT_REFRESH_TOKEN_EXPIRATION=604800

# Rate limiting (per IP)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Mail (Maildev from docker-compose: inbox at http://localhost:1080)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="NestJS Boilerplate <no-reply@example.com>"

# S3 (RustFS from docker-compose: console at http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=nestjs12-boilerplate
S3_FORCE_PATH_STYLE=true
