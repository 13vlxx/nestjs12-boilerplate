# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=mongodb://localhost:27017/
DATABASE_NAME=nestjs12-boilerplate

# Logto (docker-compose: OIDC http://localhost:3001, admin console http://localhost:3002)
LOGTO_ENDPOINT=http://localhost:3001
# Identifier of the API resource declared in Logto: the "aud" of the access tokens
LOGTO_API_RESOURCE=http://localhost:3000/api/v1
# Machine-to-machine app with the "Logto Management API access" role (see README)
LOGTO_M2M_CLIENT_ID=
LOGTO_M2M_CLIENT_SECRET=

# Rate limiting (per IP)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# S3 (RustFS from docker-compose: console at http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=nestjs12-boilerplate
S3_FORCE_PATH_STYLE=true
