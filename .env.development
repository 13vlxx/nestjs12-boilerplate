# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Base URL of the front-end, used to build links in emails
CLIENT_URL=http://localhost:5173

# Database
DATABASE_URL=mongodb://localhost:27017/
DATABASE_NAME=nestjs12-boilerplate

# JWT
JWT_ACCESS_TOKEN_SECRET=dev-only-access-secret-change-me-in-production
JWT_ACCESS_TOKEN_EXPIRATION=900
JWT_REFRESH_TOKEN_SECRET=dev-only-refresh-secret-change-me-in-production
JWT_REFRESH_TOKEN_EXPIRATION=604800

# Rate limiting (per IP)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Mail (Maildev from docker-compose: inbox at http://localhost:1080)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="NestJS Boilerplate <no-reply@example.com>"
