# Server
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=mongodb://localhost:27017/
DATABASE_NAME=nestjs12-boilerplate

# JWT
JWT_ACCESS_TOKEN_SECRET=dev-only-secret-change-me-in-production-please
JWT_ACCESS_TOKEN_EXPIRATION=3600

# Rate limiting (per IP)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
